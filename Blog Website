/* Reset some default styling */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Arial', sans-serif;
  line-height: 1.6;
  background-color: var(--bg-color, #ffffff);
  color: var(--text-color, #000000);
}

header {
  background: #333;
  color: #fff;
  padding: 1rem;
}

#navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#nav-links {
  list-style: none;
  display: flex;
  gap: 1rem;
}

#nav-links li a {
  color: white;
  text-decoration: none;
}

#menu-toggle, #theme-toggle {
  background: none;
  border: none;
  color: white;
  font-size: 1.5rem;
  cursor: pointer;
  display: none;
}

.posts, .about {
  padding: 2rem;
}

.post {
  margin-bottom: 2rem;
}

.single-post {
  padding: 2rem;
}

footer {
  text-align: center;
  padding: 1rem;
  background: #333;
  color: white;
}

/* Responsive */
@media (max-width: 768px) {
  #nav-links {
    flex-direction: column;
    display: none;
    background: #333;
    padding: 1rem;
  }
  #nav-links.active {
    display: flex;
  }
  #menu-toggle {
    display: block;
  }
}
